# APODS AI-Automation Suite - Environment Configuration Template
# Copy this file to .env and update with your actual values

# ============================================================================
# GENERAL CONFIGURATION
# ============================================================================
NODE_ENV=development
APP_NAME=APODS AI-Automation Suite
APP_VERSION=1.0.0
LOG_LEVEL=info

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=apods
POSTGRES_USER=apods
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Full database URL (used by backend)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here

# Full Redis URL (used by backend)
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# JWT Authentication
JWT_SECRET=your_very_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# CORS Settings
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Session Configuration
SESSION_SECRET=your_secure_session_secret_at_least_32_characters_long
SESSION_MAX_AGE=86400000

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
FRONTEND_PORT=5173

# API URLs
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
VITE_APP_VERSION=1.0.0
VITE_APP_NAME=APODS AI-Automation Suite

# ============================================================================
# AI SERVICES CONFIGURATION
# ============================================================================
# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096

# OpenAI API (if needed)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@apods.local

# For development: Use Mailhog
# EMAIL_HOST=localhost
# EMAIL_PORT=1025

# ============================================================================
# FILE STORAGE
# ============================================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# AWS S3 (if using cloud storage)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=apods-uploads

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================================================================
# SECURITY
# ============================================================================
# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key_here
ENCRYPTION_ALGORITHM=aes-256-gcm

# API Keys for external services
API_KEY_SALT=your_api_key_salt_here

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================
# Nginx
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# PostgreSQL for development
PGADMIN_EMAIL=admin@apods.local
PGADMIN_PASSWORD=admin

# Redis Commander
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin

# ============================================================================
# SSL/TLS CONFIGURATION (Production)
# ============================================================================
SSL_ENABLED=false
SSL_EMAIL=your-email@example.com
DOMAIN=example.com

# ============================================================================
# GRAFANA CONFIGURATION (Production)
# ============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_secure_grafana_password

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_WEBSOCKETS=true
ENABLE_FILE_UPLOADS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_METRICS=true
ENABLE_CACHING=true

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================
# Enable development features
DEV_TOOLS_ENABLED=true
DEBUG_MODE=false

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backup

# ============================================================================
# PERFORMANCE
# ============================================================================
# Worker threads
WORKER_THREADS=4

# Cache TTL (seconds)
CACHE_TTL=3600

# Connection pool sizes
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================
# Slack (for notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#apods-notifications

# GitHub (for automation)
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ============================================================================
# TESTING
# ============================================================================
TEST_DATABASE_URL=postgresql://apods_test:test_password@localhost:5432/apods_test
TEST_TIMEOUT=30000
