# APODS AI-Automation Suite Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API Key (required for AI features)
APODS_AI__API_KEY=sk-ant-your-api-key-here

# Application Settings
APODS_ENVIRONMENT=development
APODS_DEBUG=true

# Database URL
APODS_DATABASE__URL=sqlite:///apods.db

# Logging
APODS_LOGGING__LEVEL=INFO
APODS_LOGGING__FILE_PATH=logs/apods.log

# Network Settings
APODS_NETWORK__TIMEOUT=30
APODS_NETWORK__MAX_RETRIES=3

# Browser Settings
APODS_BROWSER__HEADLESS=true

# Paths
APODS_DATA_DIR=data
APODS_OUTPUT_DIR=output
APODS_TEMP_DIR=/tmp/apods
