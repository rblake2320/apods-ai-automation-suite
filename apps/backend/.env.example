# Backend Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL Connection
DATABASE_URL=postgresql://apods:apods_password@localhost:5432/apods
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Database migrations
DB_MIGRATE_ON_START=false

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_URL=redis://:redis_password@localhost:6379
REDIS_TTL=3600
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Configuration
JWT_SECRET=your_very_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your_very_secure_refresh_secret_at_least_32_characters
JWT_REFRESH_EXPIRATION=30d
JWT_ISSUER=apods-api
JWT_AUDIENCE=apods-client

# Session Configuration
SESSION_SECRET=your_secure_session_secret_at_least_32_characters_long
SESSION_NAME=apods.sid
SESSION_MAX_AGE=86400000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Password Hashing
BCRYPT_ROUNDS=10

# API Keys
API_KEY_SALT=your_api_key_salt_here

# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key_here
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_SUCCESSFUL=false

# API-specific rate limits
RATE_LIMIT_API_WINDOW=15
RATE_LIMIT_API_MAX=30

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14
LOG_DATE_PATTERN=YYYY-MM-DD

# Console logging
LOG_CONSOLE_ENABLED=true
LOG_CONSOLE_LEVEL=debug

# File logging
LOG_FILE_ENABLED=true
LOG_FILE_LEVEL=info

# ============================================================================
# AI SERVICES
# ============================================================================
# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_TIMEOUT=60000

# OpenAI API (optional)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@apods.local
EMAIL_FROM_NAME=APODS AI-Automation Suite

# Email templates
EMAIL_TEMPLATE_DIR=./templates/email

# ============================================================================
# FILE STORAGE
# ============================================================================
# Local storage
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain

# AWS S3 (if using cloud storage)
AWS_ENABLED=false
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=apods-uploads
AWS_S3_URL=https://apods-uploads.s3.amazonaws.com

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================
WS_ENABLED=true
WS_PATH=/ws
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=5000
WS_MAX_PAYLOAD=100mb

# ============================================================================
# MONITORING & METRICS
# ============================================================================
# Sentry (Error Tracking)
SENTRY_ENABLED=false
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DEBUG=false

# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Health checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# ============================================================================
# PLAYWRIGHT AUTOMATION
# ============================================================================
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_SLOW_MO=0
PLAYWRIGHT_SCREENSHOT_ON_FAILURE=true
PLAYWRIGHT_VIDEO_ON_FAILURE=false
PLAYWRIGHT_BROWSER=chromium

# ============================================================================
# WORKER & QUEUE CONFIGURATION
# ============================================================================
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
QUEUE_NAME=apods-jobs
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_PREFIX=apods:

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================
# Slack
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#apods-notifications

# GitHub
GITHUB_ENABLED=false
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ============================================================================
# SECURITY HEADERS
# ============================================================================
HELMET_ENABLED=true
HELMET_HSTS_ENABLED=true
HELMET_HSTS_MAX_AGE=31536000

# CSP (Content Security Policy)
CSP_ENABLED=true
CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline';

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_ENABLED=false
BACKUP_DIR=./backups
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ============================================================================
# DEVELOPMENT & DEBUG
# ============================================================================
DEBUG_MODE=false
DEBUG_SQL=false
DEBUG_REQUESTS=false

# Hot reload
HOT_RELOAD_ENABLED=true

# Mock services
MOCK_EMAIL=false
MOCK_AI=false

# ============================================================================
# MCP Server Configuration
# ============================================================================
MCP_CONFIG_PATH=./mcp-servers.json

# ============================================================================
# TESTING
# ============================================================================
TEST_DATABASE_URL=postgresql://apods_test:test_password@localhost:5432/apods_test
TEST_TIMEOUT=30000
TEST_PARALLEL=true
