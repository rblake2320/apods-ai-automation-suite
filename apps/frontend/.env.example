# Frontend Environment Configuration
# Copy this file to .env.local and update with your actual values

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Backend API URL
VITE_API_URL=http://localhost:3000

# WebSocket URL
VITE_WS_URL=ws://localhost:3000

# API Timeout (milliseconds)
VITE_API_TIMEOUT=30000

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application metadata
VITE_APP_NAME=APODS AI-Automation Suite
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Comprehensive automation toolkit with AI integration

# Environment
VITE_NODE_ENV=development

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_DEBUG_MODE=true
VITE_ENABLE_WEBSOCKETS=true
VITE_ENABLE_PWA=true

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Session timeout (milliseconds)
VITE_SESSION_TIMEOUT=3600000

# Token refresh interval (milliseconds)
VITE_TOKEN_REFRESH_INTERVAL=300000

# ============================================================================
# UI CONFIGURATION
# ============================================================================
# Theme
VITE_DEFAULT_THEME=light

# Language
VITE_DEFAULT_LANGUAGE=en

# Timezone
VITE_DEFAULT_TIMEZONE=UTC

# ============================================================================
# EDITOR CONFIGURATION
# ============================================================================
# Monaco Editor theme
VITE_EDITOR_THEME=vs-dark

# Editor font size
VITE_EDITOR_FONT_SIZE=14

# ============================================================================
# PAGINATION
# ============================================================================
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# ============================================================================
# FILE UPLOAD
# ============================================================================
# Max file size (bytes) - 50MB
VITE_MAX_FILE_SIZE=52428800

# Allowed file types
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================================================
# MONITORING & ANALYTICS
# ============================================================================
# Google Analytics
VITE_GA_TRACKING_ID=

# Sentry (Error Tracking)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
# Stripe (if using payments)
VITE_STRIPE_PUBLIC_KEY=

# Google Maps API (if needed)
VITE_GOOGLE_MAPS_API_KEY=

# ============================================================================
# DEVELOPMENT
# ============================================================================
# Mock API responses
VITE_USE_MOCK_API=false

# Show development warnings
VITE_SHOW_DEV_WARNINGS=true

# Enable hot reload
VITE_HMR_ENABLED=true

# ============================================================================
# PERFORMANCE
# ============================================================================
# Cache duration (seconds)
VITE_CACHE_DURATION=3600

# Enable service worker
VITE_ENABLE_SERVICE_WORKER=false

# Lazy load chunks
VITE_LAZY_LOAD=true
