#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# APODS AI-Automation Suite - Pre-commit Hook
# This hook runs before each commit to ensure code quality

echo "🔍 Running pre-commit checks..."

# Run lint-staged for file-level linting and formatting
echo "📝 Checking staged files..."
pnpm lint-staged

if [ $? -ne 0 ]; then
  echo "❌ Lint-staged failed. Please fix the errors and try again."
  exit 1
fi

# Run type checking on affected packages
echo "🔎 Type checking..."
pnpm typecheck

if [ $? -ne 0 ]; then
  echo "❌ Type checking failed. Please fix the type errors and try again."
  exit 1
fi

# Run unit tests on staged files
echo "🧪 Running unit tests..."
pnpm test:unit --passWithNoTests --bail

if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Please fix the failing tests and try again."
  exit 1
fi

# Check for sensitive information (API keys, secrets, etc.)
echo "🔐 Checking for secrets..."
if git diff --cached --name-only | xargs grep -i -E "(api[_-]?key|secret|password|token|auth[_-]?token|private[_-]?key)" | grep -v ".env.example" | grep -v "node_modules"; then
  echo "⚠️  WARNING: Potential secrets detected in staged files!"
  echo "Please review the files above and remove any sensitive information."
  echo "If these are false positives, you can skip this check with --no-verify"
  read -p "Do you want to continue anyway? (y/N) " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    exit 1
  fi
fi

# Check for console.log statements in production code
echo "🔍 Checking for console.log statements..."
if git diff --cached --name-only | grep -E "\.(ts|tsx|js|jsx)$" | grep -v "test\|spec" | xargs grep -n "console\.log" 2>/dev/null; then
  echo "⚠️  WARNING: console.log statements detected!"
  echo "Consider removing them or using a proper logging library."
  read -p "Do you want to continue anyway? (y/N) " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    exit 1
  fi
fi

# Check for TODO/FIXME comments in staged files
echo "📝 Checking for TODO/FIXME comments..."
TODO_COUNT=$(git diff --cached --name-only | xargs grep -i -n "TODO\|FIXME" 2>/dev/null | wc -l)
if [ "$TODO_COUNT" -gt 0 ]; then
  echo "ℹ️  Found $TODO_COUNT TODO/FIXME comments in staged files."
fi

echo "✅ All pre-commit checks passed!"
echo ""
